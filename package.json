{
  "name": "vitest-groq",
  "version": "1.0.0",
  "description": "Testing framework for GROQ queries — business logic testing with groq-js, performance testing with execution plan snapshots",
  "keywords": [
    "business-logic",
    "execution-plan",
    "explain",
    "groq",
    "groq-js",
    "performance",
    "query-plan",
    "sanity",
    "snapshot",
    "testing",
    "unit-test",
    "vitest"
  ],
  "homepage": "https://github.com/sanity-labs/vitest-groq#readme",
  "bugs": {
    "url": "https://github.com/sanity-labs/vitest-groq/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-labs/vitest-groq.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/plan-matchers.js"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./matchers": {
      "source": "./src/matchers.ts",
      "default": "./dist/matchers.js"
    },
    "./plan-matchers": {
      "source": "./src/plan-matchers.ts",
      "default": "./dist/plan-matchers.js"
    },
    "./groq": {
      "source": "./src/groq.ts",
      "default": "./dist/groq.js"
    },
    "./dataset": {
      "source": "./src/dataset.ts",
      "default": "./dist/dataset.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./matchers": "./dist/matchers.js",
      "./plan-matchers": "./dist/plan-matchers.js",
      "./groq": "./dist/groq.js",
      "./dataset": "./dist/dataset.js",
      "./package.json": "./package.json"
    },
    "provenance": true
  },
  "scripts": {
    "build": "pkg-utils build --strict --check",
    "check": "pkg-utils --strict",
    "watch": "pkg-utils watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint -c oxlint.config.ts",
    "format": "oxfmt -c oxfmt.config.ts .",
    "format:check": "oxfmt -c oxfmt.config.ts --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "groq-js": "^1.29.0",
    "tar-stream": "^3.1.8"
  },
  "devDependencies": {
    "@sanity/client": "^7.16.0",
    "@sanity/pkg-utils": "^12.1.0",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@types/tar-stream": "^3.1.4",
    "@vitest/expect": "^4.1.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@sanity/client": ">=6.0.0",
    "vitest": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0"
}
